<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.java.companyhouse.mapper.AdvisoryLockMapper">

<select id="acquireAdvisoryLock" parameterType="string" resultType="java.lang.Boolean">
    SELECT TRUE
    FROM (
             SELECT pg_advisory_xact_lock(hashtext(#{key}))
         ) t
</select>

</mapper>